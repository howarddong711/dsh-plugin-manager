{
  "name": "dsh-plugin-manager",
  "version": "0.1.0",
  "description": "Community plugin manager for DeepSeek Harness",
  "type": "module",
  "main": "src/dsh-plugin.js",
  "exports": {
    ".": "./src/dsh-plugin.js",
    "./core": "./src/index.js",
    "./client": "./lib/client.js",
    "./client-core": "./src/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/cli.js",
    "test": "node --test",
    "bundle": "tsdown"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "immediately": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/howarddong711/dsh-plugin-manager.git"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-locale": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-client-runtime": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.0.1-rc.1",
    "@deepseek-ai/cordis": ">=4.0.1-rc.1",
    "react": "^18.2.0"
  },
  "license": "MIT",
  "devDependencies": {
    "tsdown": "^0.22.2"
  }
}
